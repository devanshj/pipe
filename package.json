{
  "name": "@devanshj/pipe",
  "version": "0.0.3",
  "description": "A pipeline operator",
  "main": "dist/devanshj-pipe.cjs.js",
  "module": "dist/devanshj-pipe.esm.js",
  "exports": {
    ".": {
      "module": "./dist/devanshj-pipe.esm.js",
      "import": "./dist/devanshj-pipe.cjs.mjs",
      "default": "./dist/devanshj-pipe.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "preconstruct": {
    "entrypoints": [
      "index.ts"
    ],
    "exports": {
      "importConditionDefaultExport": "default"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Devansh Jethmalani",
    "email": "jethmalani.devansh@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanshj/pipe.git"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@preconstruct/cli": "^2.8.12",
    "typescript": "^5.9.3"
  }
}
